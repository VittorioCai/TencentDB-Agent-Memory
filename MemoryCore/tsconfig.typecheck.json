{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/metadata/**/*.ts", "src/gateway/skill-handlers.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
