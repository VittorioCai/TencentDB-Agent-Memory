# CodeBuddy session binding parameters (used by headerAutoSelect)
# Values come from the MemoryCore /v3/meta/* API.
#
# These are local development resource ids, not secrets, so they are committed.
# Real credentials live in deploy/global-images/.admin-key, which is gitignored.

TEAM_ID=team-n3lgrbjx7d
AGENT_ID=agt-n3lgrhe73q
TASK_ID=task-n3lg0czx0t

# Custom model registered in CodeBuddy (the id in ~/.codebuddy/models.json,
# prefixed with custom-local:)
CB_MODEL=custom-local:deepseek-v4-flash
PROXY_URL=http://127.0.0.1:8096

# ── Identity B: the evaluation consumer ─────────────────────────
# Cross-person reuse is judged on user_id, so measuring it needs a second
# identity. B consumes assets that identity A authored; the existing user stays
# the author, since it already owns the pool.
#
# Identity is derived from the API key the request carries, not from the
# x-team-id / x-agent-id headers — so switching identity means switching the
# CodeBuddy model entry, not the headers. Entry `deepseek-v4-flash-b` in
# ~/.codebuddy/models.json carries B's key.
#
# Both identities are operated by the same person. The mechanism is real; the
# ecological validity is not, and the report says so.
USER_ID_B=usr-4u07qc2kuj
AGENT_ID_B=agt-4u3ghlrv26
CB_MODEL_B=custom-local:deepseek-v4-flash-b
# Key file: deploy/global-images/.topic4-user-key-b (gitignored, mode 600)
#
# Teardown, if ever needed:
#   POST /v3/meta/agent/delete        {"agent_ids":["agt-4u3ghlrv26"]}
#   POST /v3/meta/team-member/remove  {"team_id":"team-n3lgrbjx7d","user_id":"usr-4u07qc2kuj"}
#   POST /v3/meta/user/delete         {"user_ids":["usr-4u07qc2kuj"]}
