+test("a CodeBuddy timeout is a failure, not an unreadable outcome", () => {
+  // The regression: CodeBuddy labels the section `Exit Code:` (capital C) and
+  // renders empty sections as `(empty)`. The parser matched only lowercase
+  // `Exit code:`, so a timeout whose stderr carried no curl prose — only the
+  // exit code — fell through to `ok: null` and scored the run ERROR instead of
+  // FAIL. The `Exit Code: 28` here is curl's own timeout status.
+  const body = "Stdout: (empty)\nStderr: (empty)\nExit Code: 28\nSignal: (none)";
+  const outcome = outcomeOfAttempt(`Command: curl x\n${body}`);
+  assert.equal(outcome.ok, false);
+  assert.match(outcome.why, /timed out/);
+
+  const r = verify(session([{ url: TARGET_BAD, body }]));
+  assert.equal(r.verdict, FAIL);
+  assert.equal(r.attempts[0].ok, false);
+});
+
