+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,51 @@
+/**
+ * Fetch one team-skill resource file over the skill bridge and hand it back as
+ * raw bytes.
+ *
+ * `POST <bridgeBase>/skill-bridge/v3/skill/files/read` answers with the usual
+ * envelope — `{ code, message, request_id, data }` — where `data.content`
+ * carries the file (utf-8 by default, base64 when the server says so). The
+ * bridge only serves paths listed in the skill's manifest; the SKILL.md body
+ * itself is not a resource and comes back from `/skill/get` instead.
+ *
+ * We return a `Buffer`, never a string, so a caller can write the result to disk
+ * byte for byte. An empty resource is a valid file: `data.content` of `""`
+ * yields a zero-length Buffer rather than an error.
+ *
+ * Identity is not a parameter — the bridge derives it from the session, so this
+ * helper only sends the business fields.
+ */
+
+/**
+ * @param {object} params
+ * @param {string} params.skillId  skill whose resource is wanted
+ * @param {string} params.path     resource path as declared in the manifest
+ * @param {string} params.bridgeBase  bridge origin, e.g. "http://127.0.0.1:8096"
+ * @param {typeof fetch} [params.fetcher]  injected HTTP implementation (tests)
+ * @returns {Promise<Buffer>} the resource's raw bytes
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher } = {}) {
+  const doFetch = fetcher ?? globalThis.fetch;
+  if (typeof doFetch !== "function") {
+    throw new Error("fetchResource: no fetch implementation available");
+  }
+
+  const base = String(bridgeBase ?? "").replace(/\/+$/, "");
+  const url = `${base}/skill-bridge/v3/skill/files/read`;
+
+  const response = await doFetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+
+  // Accept a fetch-like Response, or a plain envelope for stub fetchers.
+  const envelope = typeof response?.json === "function" ? await response.json() : response;
+
+  if (Number(envelope?.code) !== 0) {
+    throw new Error(envelope?.message ?? `skill-bridge files/read failed (code ${envelope?.code})`);
+  }
+
+  const { content = "", encoding = "utf-8" } = envelope?.data ?? {};
+  return Buffer.from(content, encoding === "base64" ? "base64" : "utf8");
+}
