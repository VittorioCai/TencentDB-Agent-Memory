+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,58 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BRIDGE = "http://127.0.0.1:8096";
+
+/** A stub fetcher that records the request and replays a canned envelope. */
+function stubFetcher(envelope) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init, body: JSON.parse(init.body) });
+    return { json: async () => envelope };
+  };
+  return { fetcher, calls };
+}
+
+test("fetchResource returns the resource as raw bytes", async () => {
+  const bytes = Buffer.from([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x00, 0xff]); // "hello\0\xff", not utf-8 text
+  const { fetcher, calls } = stubFetcher({
+    code: 0,
+    message: "ok",
+    data: { path: "notes.bin", content: bytes.toString("base64"), encoding: "base64" },
+  });
+
+  const result = await fetchResource({ skillId: "skl-a", path: "notes.bin", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(result));
+  assert.deepEqual(result, bytes);
+  // it asked the bridge for exactly this file
+  assert.equal(calls[0].url, `${BRIDGE}/skill-bridge/v3/skill/files/read`);
+  assert.deepEqual(calls[0].body, { skill_id: "skl-a", path: "notes.bin" });
+});
+
+test("fetchResource treats an empty resource as a zero-byte file, not an error", async () => {
+  const { fetcher } = stubFetcher({ code: 0, message: "ok", data: { content: "", encoding: "utf-8" } });
+
+  const result = await fetchResource({ skillId: "skl-a", path: "empty.md", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(result));
+  assert.equal(result.length, 0);
+});
+
+test("fetchResource decodes plain utf-8 content to bytes", async () => {
+  const { fetcher } = stubFetcher({ code: 0, message: "ok", data: { content: "你好", encoding: "utf-8" } });
+
+  const result = await fetchResource({ skillId: "skl-a", path: "note.md", bridgeBase: BRIDGE, fetcher });
+
+  assert.deepEqual(result, Buffer.from("你好", "utf8"));
+});
+
+test("fetchResource surfaces the envelope message when the bridge refuses", async () => {
+  const { fetcher } = stubFetcher({ code: 40401, message: "path SKILL.md not in manifest", data: null });
+
+  await assert.rejects(
+    fetchResource({ skillId: "skl-a", path: "SKILL.md", bridgeBase: BRIDGE, fetcher }),
+    /path SKILL\.md not in manifest/,
+  );
+});
