diff --git a/evaluation/attribution/collect-artifacts.test.mjs b/evaluation/attribution/collect-artifacts.test.mjs
new file mode 100644
index 0000000..dffa28f
--- /dev/null
+++ b/evaluation/attribution/collect-artifacts.test.mjs
@@ -0,0 +1,64 @@
+/**
+ * Regression: the exit status line of a real CodeBuddy tool result.
+ *
+ * `outcomeOf` was written against a synthetic envelope that spells the section
+ * `Exit code:` (lowercase C) and places it before `Stdout:`. Real CodeBuddy
+ * Bash results spell it `Exit Code:` (capital C) and place it after `Stderr:`,
+ * so the pattern never matched and every operation in the collected list read
+ * `exit_code: null` — leaving the downstream rule that classifies failed calls
+ * by exit status with nothing to classify on.
+ *
+ * The two cases below pin both the real spelling and the synthetic one, so the
+ * fix adds the real envelope without dropping the format the older fixtures
+ * still use.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { collectArtifacts, outcomeOf } from "./collect-artifacts.mjs";
+
+/** A CodeBuddy Bash tool result, in the exact shape real captures contain. */
+function bashResult({ command, stdout = "(empty)", stderr = "(empty)", exitCode = 0 }) {
+  return `Command: ${command}\nStdout: ${stdout}\nStderr: ${stderr}\nExit Code: ${exitCode}\nSignal: (none)`;
+}
+
+const GET = "http://127.0.0.1:8096/skill-bridge/v3/skill/get";
+
+test("outcomeOf reads the exit status from a real CodeBuddy envelope", () => {
+  const timedOut = outcomeOf(bashResult({
+    command: `curl -sSk -X POST ${GET} -d '{}'`,
+    stderr: "curl: (28) Operation timed out after 75000 ms",
+    exitCode: 28,
+  }));
+  assert.equal(timedOut.exit_code, 28);
+
+  const ok = outcomeOf(bashResult({
+    command: `curl -sSk -X POST ${GET} -d '{}'`,
+    stdout: '{"code":0,"data":{}}',
+    exitCode: 0,
+  }));
+  assert.equal(ok.exit_code, 0);
+});
+
+test("outcomeOf still reads the older lowercase envelope", () => {
+  const outcome = outcomeOf("Exit code: 1\nStdout: \nStderr: boom");
+  assert.equal(outcome.exit_code, 1);
+});
+
+test("collectArtifacts carries the real exit status into the operation", () => {
+  const captureEvents = [{
+    event: "http.request",
+    requestId: "req-1",
+    timestamp: "2026-09-04T13:30:00Z",
+    headers: { "x-conversation-id": "conv-1" },
+    body: { json: { messages: [
+      { role: "assistant", tool_calls: [{ id: "c1", function: { name: "Bash", arguments: "{}" } }] },
+      { role: "tool", tool_call_id: "c1", content: bashResult({ command: `curl -sSk -X POST ${GET} -d '{}'`, exitCode: 28 }) },
+    ] } },
+  }];
+
+  const [session] = collectArtifacts({ captureEvents });
+  const operation = session.operations.find((o) => o.call_id === "c1");
+  assert.equal(operation.result.exit_code, 28);
+});
