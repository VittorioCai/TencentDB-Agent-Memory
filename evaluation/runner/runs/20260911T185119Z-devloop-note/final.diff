index 0000000..20bef5c
--- /dev/null
+++ b/evaluation/attribution/collect-artifacts.exit-status.bt-78yk9r3bfrm.test.mjs
@@ -0,0 +1,62 @@
+/**
+ * Regression: the exit-status line of a real CodeBuddy shell result is spelled
+ * `Exit Code:` — capital C — while `outcomeOf` only accepted `Exit code:`. A
+ * real result therefore reported `exit_code: null` for every operation, and
+ * the downstream "did this call fail / time out" classification had nothing to
+ * key on: a curl that timed out with stderr suppressed (`Exit Code: 28`, no
+ * other readable text) looked exactly like a call that produced nothing.
+ *
+ * Case-insensitive matching on the label is the fix. Team experience note:
+ * `eval-tool-result-exit-line`. The marker `bt-78yk9r3bfrm` is kept in the
+ * test titles so the finding can be located later.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { collectArtifacts, outcomeOf } from "./collect-artifacts.mjs";
+
+test("reads the exit status from the capitalised Exit Code label (bt-78yk9r3bfrm)", () => {
+  // The capital spelling is what real results carry. A timed-out curl with
+  // stderr suppressed shows nothing but this line.
+  assert.equal(outcomeOf("Stdout: \nStderr: \nExit Code: 28").exit_code, 28);
+  // A non-zero, non-timeout failure must be read too.
+  assert.equal(outcomeOf("Stdout: \nExit Code: 52").exit_code, 52);
+  // Success is 0, not null.
+  assert.equal(outcomeOf("Stdout: ok\nExit Code: 0").exit_code, 0);
+  // The lower-case spelling used by older fixtures keeps working.
+  assert.equal(outcomeOf("Stdout: ok\nExit code: 7").exit_code, 7);
+});
+
+test("the collected operation list carries the exit status (bt-78yk9r3bfrm)", () => {
+  // End to end through collectArtifacts: this is the "操作清单" whose
+  // exit_code was always null on real captures.
+  const captureEvents = [{
+    event: "http.request",
+    requestId: "req-1",
+    timestamp: "2026-09-11T00:00:00Z",
+    headers: { "x-conversation-id": "conv-1" },
+    body: {
+      json: {
+        messages: [
+          {
+            role: "assistant",
+            tool_calls: [{
+              id: "c1",
+              function: { name: "Bash", arguments: '{"command":"curl -s http://127.0.0.1:47318/health"}' },
+            }],
+          },
+          {
+            role: "tool",
+            tool_call_id: "c1",
+            content: "Command: curl -s http://127.0.0.1:47318/health\nStdout: \nStderr: \nExit Code: 28",
+          },
+        ],
+      },
+    },
+  }];
+
+  const [session] = collectArtifacts({ captureEvents });
+  assert.equal(session.operations.length, 1);
+  assert.equal(session.operations[0].result.exit_code, 28);
+});
