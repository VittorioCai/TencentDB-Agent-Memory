@@ -0,0 +1,71 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BRIDGE = "http://127.0.0.1:8096";
+
+/** A fetch stub that records calls and answers with the given envelope. */
+function stub(envelope) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: true, status: 200, json: async () => envelope };
+  };
+  return { fetcher, calls };
+}
+
+test("posts skill_id/path to files/read and returns the resource bytes", async () => {
+  const { fetcher, calls } = stub({
+    code: 0,
+    message: "ok",
+    data: { content: "hello", encoding: "utf-8", size_bytes: 5 },
+  });
+  const buf = await fetchResource({ skillId: "skl-x", path: "SKILL.md", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(buf));
+  assert.equal(buf.toString("utf8"), "hello");
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, `${BRIDGE}/skill-bridge/v3/skill/files/read`);
+  assert.equal(calls[0].init.method, "POST");
+  assert.deepEqual(JSON.parse(calls[0].init.body), { skill_id: "skl-x", path: "SKILL.md" });
+});
+
+test("empty content is a legitimate zero-byte Buffer, not a falsy short-circuit", async () => {
+  const { fetcher } = stub({ code: 0, data: { content: "", encoding: "utf-8", size_bytes: 0 } });
+  const buf = await fetchResource({ skillId: "skl-x", path: "empty.txt", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(buf));
+  assert.equal(buf.length, 0);
+});
+
+test("a base64 resource is decoded back to its raw bytes", async () => {
+  const raw = Buffer.from([0x00, 0xff, 0x10, 0x80]);
+  const { fetcher } = stub({ code: 0, data: { content: raw.toString("base64"), encoding: "base64" } });
+  const buf = await fetchResource({ skillId: "skl-x", path: "bin.dat", bridgeBase: BRIDGE, fetcher });
+
+  assert.deepEqual(buf, raw);
+});
+
+test("an error envelope is thrown, message included", async () => {
+  const { fetcher } = stub({ code: 40401, message: "SKILL_NOT_FOUND: path not in manifest", data: null });
+  await assert.rejects(
+    () => fetchResource({ skillId: "skl-x", path: "nope.md", bridgeBase: BRIDGE, fetcher }),
+    /SKILL_NOT_FOUND: path not in manifest/,
+  );
+});
+
+test("defaults to globalThis.fetch when no fetcher is injected", async () => {
+  const original = globalThis.fetch;
+  let seen = null;
+  globalThis.fetch = async (url, init) => {
+    seen = { url, init };
+    return { json: async () => ({ code: 0, data: { content: "x", encoding: "utf-8" } }) };
+  };
+  try {
+    const buf = await fetchResource({ skillId: "skl-x", path: "a.txt", bridgeBase: BRIDGE });
+    assert.equal(buf.toString("utf8"), "x");
+    assert.equal(seen.url, `${BRIDGE}/skill-bridge/v3/skill/files/read`);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
