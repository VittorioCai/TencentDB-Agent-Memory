+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,41 @@
+/**
+ * Fetch one team-skill resource file as raw bytes.
+ *
+ * POSTs to the skill-bridge `files/read` endpoint and decodes the envelope's
+ * `data.content` back to bytes using the encoding the bridge reports
+ * (`"base64"` for binary resources, `"utf-8"` otherwise). The result is a
+ * `Buffer` so the caller can write it straight to disk — including the
+ * zero-byte `Buffer` for a legitimately empty resource, which is still a file.
+ *
+ * An error envelope (`code !== 0`) is surfaced as an `Error` carrying the
+ * upstream `message`; it is never swallowed into an empty result.
+ *
+ * `fetcher` is an injection seam for tests (and any non-`fetch` client that
+ * wants to supply the bytes). It defaults to `globalThis.fetch`.
+ *
+ * @param {object} args
+ * @param {string} args.skillId   skill id, e.g. "skl-xxxx"
+ * @param {string} args.path      resource path within the skill manifest
+ * @param {string} args.bridgeBase base URL of the skill bridge
+ * @param {Function} [args.fetcher] fetch-compatible HTTP implementation
+ * @returns {Promise<Buffer>} the resource's raw bytes
+ */
+export async function fetchResource({
+  skillId,
+  path,
+  bridgeBase,
+  fetcher = globalThis.fetch,
+}) {
+  const url = `${String(bridgeBase).replace(/\/+$/, "")}/skill-bridge/v3/skill/files/read`;
+  const res = await fetcher(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+  const envelope = await res.json();
+  if (envelope?.code !== 0) {
+    throw new Error(envelope?.message || `fetchResource failed (code ${envelope?.code})`);
+  }
+  const { content = "", encoding } = envelope.data ?? {};
+  return Buffer.from(content, encoding === "base64" ? "base64" : "utf8");
+}
