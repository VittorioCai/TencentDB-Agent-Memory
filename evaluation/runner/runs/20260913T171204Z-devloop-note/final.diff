index 0000000..dfc8edd
--- /dev/null
+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,92 @@
+/**
+ * Fetch one team-skill resource file as raw bytes, ready to be written to disk.
+ *
+ * The bridge exposes two read paths and they are not interchangeable:
+ *
+ *   files/read       always answers with a JSON envelope, `curl -o` or not —
+ *                    `-o` is a client flag the server never sees. A file saved
+ *                    from it is JSON, not the resource.
+ *   files/download   answers with the decoded bytes. This is the one to use
+ *                    when the point is to put the file on disk.
+ *
+ * `files/download` has one wart: its success check is `!parsed.data?.content`,
+ * and the empty string is falsy. A resource that really is empty therefore comes
+ * back as the whole JSON envelope instead of a zero-byte body. An empty file is
+ * a legal file (core accepts a zero-length `content` in both encodings), so this
+ * module does not treat it as a failure: when it sees an envelope it decodes
+ * `data.content`, and zero length decodes to a zero-byte Buffer.
+ *
+ * Only an envelope whose `code` is non-zero, or whose payload is missing or
+ * mistyped, is an error — and then the envelope's own `message` is surfaced,
+ * not swallowed.
+ */
+
+/** Decode an envelope's `data` into bytes. Empty content is legal. */
+function decodeEnvelope(envelope) {
+  if (envelope.code !== 0) {
+    throw new Error(envelope.message ?? `skill resource fetch failed (code ${envelope.code})`);
+  }
+  const data = envelope.data;
+  // The contract is a string `content` (possibly empty) plus an encoding. A
+  // missing or non-string field is a malformed response, not an empty file.
+  if (!data || typeof data.content !== "string") {
+    throw new Error(
+      envelope.message || "skill resource fetch failed: response has no string data.content",
+    );
+  }
+  return data.encoding === "base64"
+    ? Buffer.from(data.content, "base64")
+    : Buffer.from(data.content, "utf-8");
+}
+
+/**
+ * @param skillId    the asset id, e.g. "skl-xxx"
+ * @param path       the resource path taken from the skill manifest
+ * @param bridgeBase the skill bridge base, up to and including "/skill"
+ * @param fetcher    HTTP implementation to use; defaults to globalThis.fetch
+ * @returns {Promise<Buffer>} the resource's raw bytes (zero-length for an empty file)
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher }) {
+  const doFetch = fetcher ?? globalThis.fetch;
+  if (typeof doFetch !== "function") {
+    throw new Error("fetchResource: no fetch implementation available");
+  }
+
+  const base = String(bridgeBase ?? "").replace(/\/+$/, "");
+  const url = `${base}/files/download`;
+  const response = await doFetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+
+  const bytes = typeof response.arrayBuffer === "function"
+    ? Buffer.from(await response.arrayBuffer())
+    : Buffer.from(await response.text(), "utf-8");
+
+  // An envelope is JSON. The raw-bytes response carries the resource's own
+  // content type (or application/octet-stream), so JSON marks the envelope —
+  // the empty-content fallback and the pass-through error both use it.
+  const contentType = (response.headers?.get?.("content-type") ?? "").toLowerCase();
+  const text = bytes.toString("utf-8");
+  if (contentType.includes("json") || text.trimStart().startsWith("{")) {
+    let envelope;
+    try {
+      envelope = JSON.parse(text);
+    } catch {
+      envelope = null;
+    }
+    if (envelope && typeof envelope === "object" && typeof envelope.code === "number") {
+      return decodeEnvelope(envelope);
+    }
+  }
+
+  // Not an envelope: bytes are the resource. If the HTTP call itself failed and
+  // there is no envelope to explain it, do not hand back a corrupt "success".
+  if (response.ok === false) {
+    throw new Error(
+      `skill resource fetch failed: HTTP ${response.status}${text ? `: ${text.slice(0, 200)}` : ""}`,
+    );
+  }
+  return bytes;
+}
