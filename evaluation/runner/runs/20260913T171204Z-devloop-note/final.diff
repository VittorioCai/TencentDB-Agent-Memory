diff --git a/evaluation/gate/fetch-resource.bt-pu6nyfhmu2v.test.mjs b/evaluation/gate/fetch-resource.bt-pu6nyfhmu2v.test.mjs
new file mode 100644
index 0000000..5ee226f
--- /dev/null
+++ b/evaluation/gate/fetch-resource.bt-pu6nyfhmu2v.test.mjs
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const SKILL = "skl-ImeA29HL3Djj";
+const PATH = "scripts/run.sh";
+const BRIDGE = "http://127.0.0.1:8096/skill-bridge/v3/skill";
+
+/** A fetcher stub that answers every call with one Response. */
+function stub(response) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return response;
+  };
+  return { fetcher, calls };
+}
+
+const jsonResponse = (body, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+
+test("bt-pu6nyfhmu2v: download returns raw bytes, and the tool hands them back unchanged", async () => {
+  const raw = Buffer.from("#!/bin/sh\necho hi\n", "utf-8");
+  const { fetcher, calls } = stub(
+    new Response(raw, { headers: { "content-type": "text/x-shellscript" } }),
+  );
+
+  const out = await fetchResource({ skillId: SKILL, path: PATH, bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(out));
+  assert.deepEqual(out, raw);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, `${BRIDGE}/files/download`);
+  assert.deepEqual(JSON.parse(calls[0].init.body), { skill_id: SKILL, path: PATH });
+});
+
+test("an empty resource is a legal file, not an error: the empty-content envelope decodes to zero bytes", async () => {
+  // files/download answers an empty file with the whole envelope (its `!content`
+  // check is falsy for ""). That is a real, empty resource — not a failure.
+  const { fetcher } = stub(jsonResponse({ code: 0, data: { content: "", encoding: "utf-8" } }));
+
+  const out = await fetchResource({ skillId: SKILL, path: PATH, bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(out));
+  assert.equal(out.length, 0);
+});
+
+test("base64 envelopes decode to the original bytes", async () => {
+  const original = Buffer.from([0x00, 0x01, 0xfe, 0xff]);
+  const { fetcher } = stub(
+    jsonResponse({ code: 0, data: { content: original.toString("base64"), encoding: "base64" } }),
+  );
+
+  const out = await fetchResource({ skillId: SKILL, path: PATH, bridgeBase: BRIDGE, fetcher });
+
+  assert.deepEqual(out, original);
+});
+
+test("an error envelope throws with the envelope's message, not a swallowed one", async () => {
+  const { fetcher } = stub(jsonResponse({ code: 40001, message: "SKILL_RESOURCE_NOT_FOUND: nope" }));
+
+  await assert.rejects(
+    () => fetchResource({ skillId: SKILL, path: "missing.sh", bridgeBase: BRIDGE, fetcher }),
+    /SKILL_RESOURCE_NOT_FOUND: nope/,
+  );
+});
+
+test("a zero code with a missing or non-string content is malformed, not empty", async () => {
+  const { fetcher } = stub(jsonResponse({ code: 0, data: { encoding: "utf-8" } }));
+  await assert.rejects(
+    () => fetchResource({ skillId: SKILL, path: PATH, bridgeBase: BRIDGE, fetcher }),
+    /data\.content/,
+  );
+});
+
+test("fetcher defaults to globalThis.fetch when it is not injected", async () => {
+  const raw = Buffer.from("hello", "utf-8");
+  const original = globalThis.fetch;
+  let seen = null;
+  globalThis.fetch = async (url, init) => {
+    seen = { url, init };
+    return new Response(raw, { headers: { "content-type": "application/octet-stream" } });
+  };
+  try {
+    const out = await fetchResource({ skillId: SKILL, path: PATH, bridgeBase: BRIDGE });
+    assert.deepEqual(out, raw);
+    assert.equal(seen.url, `${BRIDGE}/files/download`);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
diff --git a/evaluation/gate/fetch-resource.mjs b/evaluation/gate/fetch-resource.mjs
