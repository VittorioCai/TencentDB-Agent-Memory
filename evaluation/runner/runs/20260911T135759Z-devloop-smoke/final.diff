+test("a timeout whose result carries no stderr prose is still a failure", () => {
+  // The assets document `curl -sSk`: `-s` without `--show-error`, so curl
+  // prints nothing to stderr on a timeout. CodeBuddy then returns the real
+  // shape — "Exit Code: 28" (capital C), with Stdout and Stderr empty — and the
+  // exit code is the only surviving signal. Reading it case-sensitively left
+  // the timeout unreadable, which the last-attempt rule turns into ERROR.
+  const SILENT_TIMEOUT =
+    "Command: curl -sSk -X POST http://10.244.7.19:8096/skill-bridge/v3/skill/search -d '{\"query\":\"team-bridge-reachability\"}'\n"
+    + "Stdout: (empty)\nStderr: (empty)\nExit Code: 28\nSignal: (none)";
+
+  const one = outcomeOfAttempt(SILENT_TIMEOUT);
+  assert.equal(one.ok, false, "exit 28 is a timeout, not an unreadable outcome");
+  assert.match(one.why, /timed out/);
+
+  const r = verify(session([{ url: TARGET_BAD, body: "Stdout: (empty)\nStderr: (empty)\nExit Code: 28\nSignal: (none)" }]));
+  assert.equal(r.verdict, FAIL, "a timed-out last attempt is a failure, not ERROR");
+  assert.equal(r.attempts[0].ok, false);
+});
+
