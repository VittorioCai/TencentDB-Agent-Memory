+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BRIDGE = "http://127.0.0.1:8096/skill-bridge/v3/skill";
+
+/** A stub fetcher that records the call and answers with a canned body. */
+function stubFetcher({ json, text = JSON.stringify(json) }) {
+  const calls = [];
+  const fetcher = async (url, options) => {
+    calls.push({ url, options });
+    return { text: async () => text };
+  };
+  return { fetcher, calls };
+}
+
+test("success returns the resource's original bytes", async () => {
+  const bytes = Buffer.from("#!/bin/sh\necho hi\n", "utf8");
+  const { fetcher, calls } = stubFetcher({
+    json: { code: 0, message: "ok", data: { path: "scripts/run.sh", content: bytes.toString("base64"), encoding: "base64", size_bytes: bytes.length } },
+  });
+
+  const out = await fetchResource({ skillId: "skl-abc", path: "scripts/run.sh", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(out));
+  assert.deepEqual(out, bytes);
+  // The request went to files/read and asked for base64, so the bytes survive.
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, `${BRIDGE}/files/read`);
+  assert.equal(calls[0].options.method, "POST");
+  assert.deepEqual(JSON.parse(calls[0].options.body), { skill_id: "skl-abc", path: "scripts/run.sh", encoding: "base64" });
+});
+
+test("an empty resource is a zero-byte Buffer, not an error", async () => {
+  const { fetcher } = stubFetcher({ json: { code: 0, message: "ok", data: { path: "empty.txt", content: "", encoding: "base64", size_bytes: 0 } } });
+
+  const out = await fetchResource({ skillId: "skl-abc", path: "empty.txt", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(out));
+  assert.equal(out.length, 0);
+});
+
+test("binary bytes round-trip unchanged", async () => {
+  const bytes = Buffer.from([0x00, 0xff, 0x10, 0x80, 0x7f]);
+  const { fetcher } = stubFetcher({ json: { code: 0, message: "ok", data: { content: bytes.toString("base64"), encoding: "base64" } } });
+
+  const out = await fetchResource({ skillId: "skl-abc", path: "bin.dat", bridgeBase: BRIDGE, fetcher });
+
+  assert.deepEqual(out, bytes);
+});
+
+test("an error envelope is thrown, not swallowed, keeping the message", async () => {
+  const { fetcher } = stubFetcher({ json: { code: 40401, message: "SKILL_NOT_FOUND: no such resource" } });
+
+  await assert.rejects(
+    () => fetchResource({ skillId: "skl-nope", path: "x", bridgeBase: BRIDGE, fetcher }),
+    /SKILL_NOT_FOUND: no such resource/,
+  );
+});
+
+test("the default fetcher is globalThis.fetch", async () => {
+  const original = globalThis.fetch;
+  const bytes = Buffer.from("ok", "utf8");
+  let seenUrl = null;
+  globalThis.fetch = async (url) => {
+    seenUrl = url;
+    return { text: async () => JSON.stringify({ code: 0, message: "ok", data: { content: bytes.toString("base64"), encoding: "base64" } }) };
+  };
+  try {
+    const out = await fetchResource({ skillId: "skl-abc", path: "a.txt", bridgeBase: BRIDGE });
+    assert.equal(seenUrl, `${BRIDGE}/files/read`);
+    assert.deepEqual(out, bytes);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
