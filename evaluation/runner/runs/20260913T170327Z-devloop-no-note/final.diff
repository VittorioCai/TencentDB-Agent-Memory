--- /dev/null
+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,75 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BRIDGE = "http://127.0.0.1:8096/skill-bridge/v3/skill";
+
+/** A fetch stub whose response body is the given envelope. Records its calls. */
+function stubFetcher(envelope) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return { json: async () => envelope };
+  };
+  fetcher.calls = calls;
+  return fetcher;
+}
+
+test("returns the resource's raw bytes and asks the bridge for a base64 read", async () => {
+  // Bytes that are not valid utf-8: decoding them as text would lose them.
+  const bytes = Buffer.from([0x00, 0x01, 0xff, 0xfe, 0x80]);
+  const fetcher = stubFetcher({
+    code: 0,
+    data: { content: bytes.toString("base64"), encoding: "base64", size_bytes: bytes.length },
+  });
+
+  const got = await fetchResource({ skillId: "skl-abc", path: "assets/blob.bin", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(got));
+  assert.deepEqual([...got], [...bytes]);
+  assert.equal(fetcher.calls.length, 1);
+  assert.equal(fetcher.calls[0].url, `${BRIDGE}/files/read`);
+  assert.deepEqual(JSON.parse(fetcher.calls[0].init.body), {
+    skill_id: "skl-abc",
+    path: "assets/blob.bin",
+    encoding: "base64",
+  });
+});
+
+test("an empty resource is a zero-byte buffer, not a failure", async () => {
+  const fetcher = stubFetcher({ code: 0, data: { content: "", encoding: "base64", size_bytes: 0 } });
+
+  const got = await fetchResource({ skillId: "skl-abc", path: "empty.txt", bridgeBase: BRIDGE, fetcher });
+
+  assert.ok(Buffer.isBuffer(got));
+  assert.equal(got.length, 0);
+});
+
+test("an error envelope is thrown with the envelope's message", async () => {
+  const fetcher = stubFetcher({ code: 40301, message: "SKILL_NOT_ADMITTED: candidate", request_id: "r1" });
+
+  await assert.rejects(
+    () => fetchResource({ skillId: "skl-abc", path: "SKILL.md", bridgeBase: BRIDGE, fetcher }),
+    (err) => err instanceof Error && /SKILL_NOT_ADMITTED/.test(err.message),
+  );
+});
+
+test("a utf-8 resource decodes as utf-8, and fetcher defaults to globalThis.fetch", async () => {
+  const utf8 = stubFetcher({ code: 0, data: { content: "héllo", encoding: "utf-8" } });
+  const decoded = await fetchResource({ skillId: "skl-abc", path: "SKILL.md", bridgeBase: BRIDGE, fetcher: utf8 });
+  assert.equal(decoded.toString("utf8"), "héllo");
+
+  const original = globalThis.fetch;
+  let called = null;
+  globalThis.fetch = async (url) => {
+    called = url;
+    return { json: async () => ({ code: 0, data: { content: "x", encoding: "utf-8" } }) };
+  };
+  try {
+    const viaDefault = await fetchResource({ skillId: "skl-abc", path: "SKILL.md", bridgeBase: BRIDGE });
+    assert.equal(viaDefault.toString("utf8"), "x");
+    assert.equal(called, `${BRIDGE}/files/read`);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
