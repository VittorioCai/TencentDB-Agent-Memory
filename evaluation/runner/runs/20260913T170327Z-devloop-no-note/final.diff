+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,44 @@
+/**
+ * Fetch one skill resource as raw bytes.
+ *
+ * `POST /v3/skill/files/read` answers with the usual JSON envelope; on success
+ * `data.content` is a string that `data.encoding` says how to read. We ask for
+ * `base64` so the bytes survive the round trip unchanged — a `utf-8` read of a
+ * binary resource is lossy — and decode back to a `Buffer` the caller can write
+ * straight to disk.
+ *
+ * Two cases are deliberately not special-cased away:
+ *
+ *   - An empty file is a legal file. `content: ""` decodes to a zero-byte
+ *     buffer; it is not an error and must not be reported as a missing value.
+ *   - A non-zero `code` is the upstream's own message and is not swallowed.
+ *     The caller gets an `Error` carrying that message.
+ *
+ * The HTTP implementation is injectable so this mapping (request → bytes) can
+ * be tested without a running stack; when the caller passes nothing, the
+ * platform's `globalThis.fetch` is used.
+ */
+
+/**
+ * @param skillId    the skill to read from (the bridge's `skill_id`)
+ * @param path       the resource path as declared in that skill's manifest
+ * @param bridgeBase base URL the skill actions hang off, e.g.
+ *                   "http://127.0.0.1:8096/skill-bridge/v3/skill"
+ * @param fetcher    fetch-compatible HTTP implementation (default: globalThis.fetch)
+ * @returns {Promise<Buffer>} the resource's raw bytes
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher = globalThis.fetch }) {
+  const url = `${String(bridgeBase).replace(/\/+$/, "")}/files/read`;
+  const res = await fetcher(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path, encoding: "base64" }),
+  });
+  // A Response exposes `.json()`; a plain stub may hand back the envelope itself.
+  const envelope = typeof res?.json === "function" ? await res.json() : res;
+  if (envelope?.code !== 0) {
+    throw new Error(envelope?.message ?? `files/read failed (code ${envelope?.code})`);
+  }
+  const { content = "", encoding } = envelope.data ?? {};
+  return Buffer.from(content ?? "", encoding === "base64" ? "base64" : "utf8");
+}
diff --git a/evaluation/gate/fetch-resource.test.mjs b/evaluation/gate/fetch-resource.test.mjs
