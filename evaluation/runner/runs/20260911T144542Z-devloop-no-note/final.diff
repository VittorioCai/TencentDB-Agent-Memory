+test("a timeout in CodeBuddy's result format is a failure, not an unreadable outcome", () => {
+  // CodeBuddy's Bash tool writes the exit line as `Exit Code:` (capital C), as
+  // gate0/verify-capture.mjs documents. A case-sensitive `Exit code:` regex
+  // reads no exit code from a real capture, so a curl (28) whose stderr does not
+  // contain the exact "operation/connection timed out" wording — here
+  // "Couldn't connect to server", observed on the wrong address — fell through
+  // to "outcome not readable" and the run was scored ERROR instead of FAIL.
+  const result = [
+    "Stdout: (empty)",
+    "Stderr: curl: (28) Couldn't connect to server",
+    "Exit Code: 28",
+    "Signal: (none)",
+  ].join("\n");
+  const r = verify(session([{ url: TARGET_BAD, body: result }]));
+  assert.equal(r.attempts[0].ok, false);
+  assert.match(r.attempts[0].why, /timed out/);
+  assert.equal(r.verdict, FAIL);
+  assert.match(r.reason, /timed out/);
+});
+
