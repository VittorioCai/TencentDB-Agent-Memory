index 0000000..da7bc20
--- /dev/null
+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,49 @@
+/**
+ * Fetch one skill resource's bytes from the bridge.
+ *
+ * The bridge returns a JSON envelope, not raw bytes:
+ *
+ *   { code: 0, message: "ok", request_id, data: { path, content, encoding, size_bytes, mime_type, version } }
+ *
+ * `content` is the resource re-encoded for transport — `base64` when asked,
+ * `utf-8` by default — and `encoding` says which. This helper turns that back
+ * into the original bytes so a caller can write the file without knowing the
+ * wire format. An empty resource is a legitimate file: its `content` is the
+ * empty string and the result is a zero-length Buffer, never a null.
+ *
+ * A `code !== 0` reply is the upstream's own error (missing path, not admitted,
+ * not found); it is surfaced as an Error carrying the envelope's `message`, so
+ * the reason survives instead of being flattened to "request failed".
+ *
+ * The HTTP implementation is injected so this is testable without a live
+ * bridge; when omitted it uses `globalThis.fetch`.
+ */
+
+const READ_PATH = "/skill-bridge/v3/skill/files/read";
+
+/**
+ * @param skillId   the skill whose resource to read
+ * @param path      resource path within the skill's manifest
+ * @param bridgeBase origin of the bridge, e.g. http://127.0.0.1:8096
+ * @param fetcher   fetch-compatible function; defaults to globalThis.fetch
+ * @returns {Promise<Buffer>} the resource's raw bytes
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher }) {
+  const doFetch = fetcher ?? globalThis.fetch;
+  const url = `${String(bridgeBase).replace(/\/+$/, "")}${READ_PATH}`;
+
+  const res = await doFetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path, encoding: "base64" }),
+  });
+
+  const envelope = await res.json();
+  if (!envelope || envelope.code !== 0) {
+    throw new Error(envelope?.message ?? `resource fetch failed (code ${envelope?.code})`);
+  }
+
+  const { content, encoding } = envelope.data ?? {};
+  if (content == null) return Buffer.alloc(0);
+  return Buffer.from(content, encoding === "base64" ? "base64" : "utf8");
+}
diff --git a/evaluation/gate/fetch-resource.test.mjs b/evaluation/gate/fetch-resource.test.mjs
