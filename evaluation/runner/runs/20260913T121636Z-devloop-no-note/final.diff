+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,83 @@
+/**
+ * fetch-resource: turn a bridge files/read envelope back into raw bytes.
+ *
+ * Three properties matter and each has a way of going wrong silently:
+ *   - the bytes are the resource's own (so a binary resource must not be run
+ *     through a utf-8 round trip);
+ *   - an empty resource is a file, not a missing one — zero bytes, and the
+ *     caller can still write it;
+ *   - an upstream error envelope is not a success with empty data; its message
+ *     must reach the caller.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { fetchResource } from "./fetch-resource.mjs";
+
+/** A stub fetcher: records the call, replies with the given envelope. */
+function stub(envelope) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return { json: async () => envelope };
+  };
+  return { calls, fetcher };
+}
+
+test("returns the resource's raw bytes, decoding base64", () => {
+  const bytes = Buffer.from([0x00, 0xff, 0x10, 0x80, 0x7f]);
+  const { calls, fetcher } = stub({
+    code: 0,
+    message: "ok",
+    data: { path: "scripts/run.sh", content: bytes.toString("base64"), encoding: "base64", size_bytes: bytes.length },
+  });
+
+  return fetchResource({ skillId: "skl-abc", path: "scripts/run.sh", bridgeBase: "http://127.0.0.1:8096", fetcher })
+    .then((buf) => {
+      assert.ok(Buffer.isBuffer(buf), "must be a Buffer");
+      assert.deepEqual(buf, bytes, "binary bytes survive the round trip");
+      assert.equal(calls.length, 1);
+      assert.match(calls[0].url, /\/skill-bridge\/v3\/skill\/files\/read$/);
+      assert.deepEqual(JSON.parse(calls[0].init.body), { skill_id: "skl-abc", path: "scripts/run.sh", encoding: "base64" });
+    });
+});
+
+test("an empty resource is a zero-byte Buffer, not null and not an error", async () => {
+  const { fetcher } = stub({
+    code: 0,
+    message: "ok",
+    data: { path: "empty.txt", content: "", encoding: "utf-8", size_bytes: 0 },
+  });
+
+  const buf = await fetchResource({ skillId: "skl-abc", path: "empty.txt", bridgeBase: "http://127.0.0.1:8096", fetcher });
+  assert.ok(Buffer.isBuffer(buf));
+  assert.equal(buf.length, 0);
+});
+
+test("a utf-8 envelope is decoded as written", async () => {
+  const { fetcher } = stub({
+    code: 0,
+    message: "ok",
+    data: { path: "note.md", content: "你好\n", encoding: "utf-8", size_bytes: 7 },
+  });
+
+  const buf = await fetchResource({ skillId: "skl-abc", path: "note.md", bridgeBase: "http://127.0.0.1:8096", fetcher });
+  assert.deepEqual(buf, Buffer.from("你好\n", "utf8"));
+});
+
+test("an error envelope becomes an Error carrying the upstream message", async () => {
+  const { fetcher } = stub({ code: 40401, message: "SKILL_NOT_FOUND: path x not in manifest of v2" });
+
+  await assert.rejects(
+    fetchResource({ skillId: "skl-abc", path: "x", bridgeBase: "http://127.0.0.1:8096", fetcher }),
+    /SKILL_NOT_FOUND: path x not in manifest of v2/,
+  );
+});
+
+test("bridgeBase trailing slash does not double up the path", async () => {
+  const { calls, fetcher } = stub({ code: 0, message: "ok", data: { path: "a", content: "aGk=", encoding: "base64" } });
+
+  await fetchResource({ skillId: "skl-abc", path: "a", bridgeBase: "http://127.0.0.1:8096/", fetcher });
+  assert.equal(calls[0].url, "http://127.0.0.1:8096/skill-bridge/v3/skill/files/read");
+});
