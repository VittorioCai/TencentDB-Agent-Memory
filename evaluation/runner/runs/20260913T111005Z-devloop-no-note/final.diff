index 0000000..89ab45a
--- /dev/null
+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,52 @@
+/**
+ * Fetch one resource file of a team skill from the skill bridge, as raw bytes.
+ *
+ * Route this through `files/download`, not `files/read`. `files/read` answers
+ * with a JSON envelope no matter how it is called (`-o` included), so a caller
+ * that wants the file's bytes has to peel `data.content` off by hand. The
+ * bridge's `files/download` is the byte-oriented path — it is the one the
+ * `curl -o <local_path>` recipe in the tool catalogue is written for — and it
+ * returns the resource's raw bytes.
+ *
+ * A failure still arrives as the JSON envelope (`code !== 0`), so that case is
+ * read and thrown with the upstream `message` kept intact rather than being
+ * written out as if it were the file's contents.
+ *
+ * An empty resource is a legal resource. `data.content === ""` must decode to a
+ * zero-byte Buffer, never be mistaken for "nothing came back" and thrown on —
+ * the bridge's own download path folds `!content` into its error branch, and a
+ * zero-byte file must not inherit that bug.
+ *
+ * `fetcher` is injectable so a test can drive the call with a stub; in
+ * production it is the ambient `globalThis.fetch`.
+ *
+ * @param {string}   skillId     the skill the resource belongs to
+ * @param {string}   path        the resource path within the skill
+ * @param {string}   bridgeBase  bridge skill root, e.g.
+ *                               http://127.0.0.1:8096/skill-bridge/v3/skill
+ * @param {Function} [fetcher]   fetch-compatible HTTP implementation
+ * @returns {Promise<Buffer>}    the resource's raw bytes
+ *
+ * Usage:
+ *   const bytes = await fetchResource({ skillId, path, bridgeBase });
+ *   await writeFile(dest, bytes);
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher = globalThis.fetch } = {}) {
+  const base = String(bridgeBase ?? "").replace(/\/+$/, "");
+  const response = await fetcher(`${base}/files/download`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+
+  const envelope = await response.json();
+  if (envelope === null || typeof envelope !== "object" || envelope.code !== 0) {
+    throw new Error(`fetch-resource: ${envelope?.message ?? "upstream returned no usable envelope"}`);
+  }
+
+  const { content, encoding } = envelope.data ?? {};
+  if (typeof content !== "string") {
+    throw new Error("fetch-resource: upstream returned no usable envelope");
+  }
+  return Buffer.from(content, encoding === "base64" ? "base64" : "utf-8");
+}
