index 0000000..ba82d76
--- /dev/null
+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,91 @@
+/**
+ * `fetchResource` is how the gate pulls a skill resource down to a local file.
+ * The cases worth pinning are the ones that decide whether a caller can trust
+ * the return value:
+ *
+ *   - success gives back the resource's bytes, decoded per the envelope's own
+ *     `encoding`, as a `Buffer`;
+ *   - an empty resource is an empty file, not a missing one — the return is a
+ *     zero-length `Buffer`, so writing it to disk is a no-op that still
+ *     succeeds;
+ *   - an error envelope (`code !== 0`) is thrown with its `message`, because
+ *     that message is the only description of what went wrong.
+ *
+ * The `fetcher` seam is exercised directly: the stub is handed the request and
+ * the response it returns is what the tool must act on.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BRIDGE = "http://127.0.0.1:8096/skill-bridge/v3/skill";
+
+/** A stub fetch that records the call and answers with `envelope`. */
+function stubFetch(envelope) {
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: true, json: async () => envelope };
+  };
+  fetcher.calls = calls;
+  return fetcher;
+}
+
+test("returns the resource bytes as a Buffer, decoding per the envelope encoding", async () => {
+  const text = stubFetch({ code: 0, data: { content: "# hello\n", encoding: "utf-8" } });
+  const fromText = await fetchResource({ skillId: "skl-a", path: "doc.md", bridgeBase: BRIDGE, fetcher: text });
+  assert.ok(Buffer.isBuffer(fromText), "a Buffer, so the caller can write it to disk");
+  assert.equal(fromText.toString("utf8"), "# hello\n");
+
+  const encoded = stubFetch({ code: 0, data: { content: "aGVsbG8=", encoding: "base64" } });
+  const fromBase64 = await fetchResource({ skillId: "skl-a", path: "blob.bin", bridgeBase: BRIDGE, fetcher: encoded });
+  assert.deepEqual([...fromBase64], [104, 101, 108, 108, 111]);
+});
+
+test("an empty resource is a zero-byte Buffer, not a failure", async () => {
+  const fetcher = stubFetch({ code: 0, data: { content: "", encoding: "utf-8" } });
+  const buf = await fetchResource({ skillId: "skl-a", path: "empty.md", bridgeBase: BRIDGE, fetcher });
+  assert.ok(Buffer.isBuffer(buf));
+  assert.equal(buf.length, 0);
+
+  // A missing `content` is the same empty file, not an exception.
+  const missing = stubFetch({ code: 0, data: {} });
+  const buf2 = await fetchResource({ skillId: "skl-a", path: "empty.md", bridgeBase: BRIDGE, fetcher: missing });
+  assert.equal(buf2.length, 0);
+});
+
+test("an error envelope is thrown with the envelope's message", async () => {
+  const fetcher = stubFetch({ code: 40401, message: "SKILL_NOT_FOUND: skl-a is not visible", data: null });
+  await assert.rejects(
+    () => fetchResource({ skillId: "skl-a", path: "doc.md", bridgeBase: BRIDGE, fetcher }),
+    (err) => err instanceof Error && /SKILL_NOT_FOUND/.test(err.message),
+    "the envelope message must survive into the Error",
+  );
+});
+
+test("posts skill_id and path to <bridgeBase>/files/read", async () => {
+  const fetcher = stubFetch({ code: 0, data: { content: "", encoding: "utf-8" } });
+  await fetchResource({ skillId: "skl-a", path: "docs/a.md", bridgeBase: `${BRIDGE}/`, fetcher });
+  const [{ url, init }] = fetcher.calls;
+  assert.equal(url, `${BRIDGE}/files/read`, "a trailing slash on the base must not double up");
+  assert.equal(init.method, "POST");
+  assert.deepEqual(JSON.parse(init.body), { skill_id: "skl-a", path: "docs/a.md" });
+});
+
+test("defaults to globalThis.fetch when no fetcher is supplied", async () => {
+  const original = globalThis.fetch;
+  const seen = [];
+  globalThis.fetch = async (url, init) => {
+    seen.push(url);
+    return { ok: true, json: async () => ({ code: 0, data: { content: "ok", encoding: "utf-8" } }) };
+  };
+  try {
+    const buf = await fetchResource({ skillId: "skl-a", path: "doc.md", bridgeBase: BRIDGE });
+    assert.equal(buf.toString("utf8"), "ok");
+    assert.equal(seen.length, 1);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
