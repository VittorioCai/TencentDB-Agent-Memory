index 0000000..a45272b
--- /dev/null
+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,57 @@
+/**
+ * Fetch one skill resource's bytes over the bridge.
+ *
+ * The bridge's `files/read` op answers with the standard envelope
+ * `{ code, message, request_id, data }`. `data.content` is the resource as a
+ * string whose encoding `data.encoding` names (`utf-8` or `base64`), so the
+ * bytes are recovered by decoding according to that field rather than by
+ * assuming the resource is text.
+ *
+ * Two things the caller depends on and that are easy to get wrong:
+ *
+ *   - An empty resource is a real file. It has to come back as a zero-length
+ *     `Buffer`, not as `null` / `undefined` / `""` / an error — an empty file
+ *     is a legal file, and a caller that writes the result to disk must be able
+ *     to write it.
+ *   - An envelope with `code !== 0` is a failure. Its `message` is the only
+ *     place the reason lives, so it is carried into the thrown `Error` instead
+ *     of being swallowed into an empty result that looks like success.
+ *
+ * `fetcher` is injectable so tests can supply a stub; it defaults to the
+ * global `fetch`.
+ */
+
+/** Join a base URL and a subpath without doubling or dropping the slash. */
+function joinUrl(base, sub) {
+  return `${String(base ?? "").replace(/\/+$/, "")}/${String(sub).replace(/^\/+/, "")}`;
+}
+
+/** Read the JSON envelope from either a fetch Response or an already-decoded stub. */
+async function readEnvelope(response) {
+  if (response && typeof response.json === "function") return response.json();
+  return response;
+}
+
+export async function fetchResource({ skillId, path, bridgeBase, fetcher }) {
+  const doFetch = fetcher ?? globalThis.fetch;
+  const url = joinUrl(bridgeBase, "files/read");
+  const response = await doFetch(url, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      "x-tdai-service-id": "default",
+    },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+
+  const envelope = await readEnvelope(response);
+  if (!envelope || envelope.code !== 0) {
+    throw new Error(envelope?.message ?? `files/read failed (code=${envelope?.code ?? "?"})`);
+  }
+
+  // A missing `content` is an empty resource, and `Buffer.from("", ...)` is
+  // zero bytes — the empty file the caller is allowed to write.
+  const content = envelope.data?.content ?? "";
+  const encoding = envelope.data?.encoding === "base64" ? "base64" : "utf-8";
+  return Buffer.from(content, encoding);
+}
diff --git a/evaluation/gate/fetch-resource.test.mjs b/evaluation/gate/fetch-resource.test.mjs
