+/**
+ * Regression for the exit-status line in a real CodeBuddy tool result.
+ *
+ * The Bash tool result spells the label `Exit Code:` (capital C). The
+ * collector read only `Exit code:`, so every real result came back with
+ * `result.exit_code === null` — a curl that timed out (28) or was reset (56)
+ * looked like an outcome nobody could read rather than a failed call.
+ *
+ * Case: bt-78yk9r3bfrm.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { collectArtifacts, outcomeOf } from "./collect-artifacts.mjs";
+
+test("bt-78yk9r3bfrm — the real `Exit Code:` spelling yields an exit status", () => {
+  // Capital C, the spelling every real result uses.
+  assert.equal(
+    outcomeOf("Stdout: \nStderr: \nExit Code: 28").exit_code,
+    28,
+    "capital spelling must be read",
+  );
+
+  // The lower-case spelling of the hand-written fixtures still works.
+  assert.equal(outcomeOf("Stdout: x\nExit code: 0").exit_code, 0, "lower-case spelling must still work");
+
+  // And it survives the whole collection path, which is what downstream
+  // classifies failed calls on.
+  const captureEvents = [{
+    event: "http.request",
+    requestId: "req-1",
+    timestamp: "2026-09-11T00:00:00Z",
+    headers: { "x-conversation-id": "conv-bt78" },
+    body: { json: { messages: [
+      {
+        role: "assistant",
+        tool_calls: [{ id: "c1", function: { name: "Bash", arguments: '{"command":"curl -s http://127.0.0.1:1"}' } }],
+      },
+      { role: "tool", tool_call_id: "c1", content: "Command: curl -s http://127.0.0.1:1\nStdout: \nStderr: \nExit Code: 28" },
+    ] } },
+  }];
+
+  const [session] = collectArtifacts({ captureEvents });
+  assert.equal(session.operations[0].result.exit_code, 28);
+});
