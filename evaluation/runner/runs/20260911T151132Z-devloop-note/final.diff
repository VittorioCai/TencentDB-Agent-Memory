@@ -115,6 +115,23 @@ test("a timeout is read from the exit code, not from prose", () => {
   assert.match(outcomeOfAttempt(TIMEOUT).why, /timed out/);
 });
 
+test("a CodeBuddy result whose timeout stderr is not a known phrase is a failure, not unreadable", () => {
+  // CodeBuddy spells the section header `Exit Code:`. The reader matched only
+  // lowercase `Exit code`, so curl's exit 28 was never seen and a timeout whose
+  // stderr did not carry "Operation timed out"/"Connection timed out" (DNS
+  // timeouts say "Resolving timed out") fell through to ok: null and scored ERROR.
+  const result = [
+    "Command: curl -sSk -X POST http://10.244.7.19:8096/skill-bridge/v3/skill/search -d '{\"query\":\"team-bridge-reachability\"}'",
+    "Stdout: (empty)",
+    "Stderr: curl: (28) Resolving timed out after 20001 milliseconds",
+    "Exit Code: 28",
+    "Signal: (none)",
+  ].join("\n");
+  const a = outcomeOfAttempt(result);
+  assert.equal(a.ok, false);
+  assert.match(a.why, /timed out/);
+});
+
