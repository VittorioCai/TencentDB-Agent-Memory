+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,55 @@
+/**
+ * Fetch one resource file out of a team skill, as bytes.
+ *
+ * The bridge's `files/read` answers with an envelope:
+ *
+ *   { code, message, data: { path, content, encoding, size_bytes, mime_type, version } }
+ *
+ * `content` is the file's text in `encoding`. Ask for `base64` so the round
+ * trip does not depend on the file being text — a script, a PNG and a JSON
+ * fixture all come back byte-for-byte — and decode here, so the caller gets a
+ * Buffer it can write to disk without further interpretation.
+ *
+ * An empty resource is a real resource. `content: ""` decodes to a zero-byte
+ * Buffer; it is not an error and not `null`, because an empty file is a legal
+ * file and a caller must be able to write one.
+ *
+ * A non-zero `code` is the bridge refusing (40301 not admitted, 40401 path not
+ * in the manifest, …), not a transport failure. It is thrown with the
+ * envelope's own `message` so the caller can report what the bridge said
+ * instead of inventing a reason.
+ *
+ * `fetcher` is injectable so the decision logic above can be tested against a
+ * stub; it defaults to the platform fetch.
+ *
+ * Usage:
+ *   const bytes = await fetchResource({
+ *     skillId: "skl-xxx", path: "scripts/run.sh",
+ *     bridgeBase: "http://127.0.0.1:8096/skill-bridge/v3/skill",
+ *   });
+ *   writeFileSync("run.sh", bytes);
+ */
+
+export async function fetchResource({ skillId, path, bridgeBase, fetcher = globalThis.fetch }) {
+  const base = String(bridgeBase ?? "").replace(/\/+$/, "");
+  const response = await fetcher(`${base}/files/read`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path, encoding: "base64" }),
+  });
+
+  const envelope = await response.json();
+  const code = envelope?.code;
+  // An absent code is not an error envelope; a present, non-zero one is.
+  if (code != null && Number(code) !== 0) {
+    throw new Error(envelope?.message ?? `files/read refused (code ${code})`);
+  }
+
+  const content = envelope?.data?.content ?? "";
+  // The server echoes the encoding it used. Honour it rather than assuming
+  // base64 came back: a "utf-8" response is still the same bytes.
+  const encoding = envelope?.data?.encoding === "base64" ? "base64" : "utf8";
+  return Buffer.from(content, encoding);
+}
+
+export default fetchResource;
