@@ -0,0 +1,84 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BASE = "http://127.0.0.1:8096/skill-bridge/v3/skill";
+
+/** A fetcher stub returning one envelope, recording the call it was given. */
+function stubFetcher(envelope, capture = {}) {
+  return async (url, options) => {
+    capture.url = url;
+    capture.options = options;
+    return { ok: true, json: async () => envelope };
+  };
+}
+
+test("returns the resource's raw bytes and posts files/read with base64", async () => {
+  // Bytes that do not survive a text round trip — NUL and 0xFF are the point.
+  const bytes = Buffer.from([0x00, 0xff, 0x10, 0x00, 0x68]);
+  const capture = {};
+  const out = await fetchResource({
+    skillId: "skl-1",
+    path: "scripts/run.sh",
+    bridgeBase: BASE,
+    fetcher: stubFetcher({ code: 0, message: "ok", data: { content: bytes.toString("base64"), encoding: "base64" } }, capture),
+  });
+  assert.ok(Buffer.isBuffer(out), "the caller must be able to write the result straight to a file");
+  assert.deepEqual(out, bytes);
+  assert.equal(capture.url, `${BASE}/files/read`);
+  assert.equal(capture.options.method, "POST");
+  assert.deepEqual(JSON.parse(capture.options.body), {
+    skill_id: "skl-1",
+    path: "scripts/run.sh",
+    encoding: "base64",
+  });
+});
+
+test("an empty resource is a zero-byte Buffer, not an error", async () => {
+  const out = await fetchResource({
+    skillId: "skl-1",
+    path: "empty.txt",
+    bridgeBase: BASE,
+    fetcher: stubFetcher({ code: 0, message: "ok", data: { content: "", encoding: "base64", size_bytes: 0 } }),
+  });
+  assert.ok(Buffer.isBuffer(out));
+  assert.equal(out.length, 0);
+});
+
+test("a utf-8 response decodes to the same bytes", async () => {
+  const out = await fetchResource({
+    skillId: "skl-1",
+    path: "note.md",
+    bridgeBase: BASE,
+    fetcher: stubFetcher({ code: 0, message: "ok", data: { content: "héllo", encoding: "utf-8" } }),
+  });
+  assert.deepEqual(out, Buffer.from("héllo", "utf8"));
+});
+
+test("a non-zero envelope code throws, carrying the envelope's message", async () => {
+  const envelope = { code: 40301, message: "SKILL_NOT_ADMITTED: skl-nope is not in the admitted pool" };
+  await assert.rejects(
+    () => fetchResource({ skillId: "skl-nope", path: "x.md", bridgeBase: BASE, fetcher: stubFetcher(envelope) }),
+    (err) => {
+      assert.ok(err instanceof Error);
+      assert.equal(err.message, envelope.message);
+      return true;
+    },
+  );
+});
+
+test("fetcher defaults to globalThis.fetch", async () => {
+  const original = globalThis.fetch;
+  let calls = 0;
+  globalThis.fetch = async () => {
+    calls += 1;
+    return { json: async () => ({ code: 0, message: "ok", data: { content: "", encoding: "base64" } }) };
+  };
+  try {
+    await fetchResource({ skillId: "skl-1", path: "p", bridgeBase: BASE });
+  } finally {
+    globalThis.fetch = original;
+  }
+  assert.equal(calls, 1);
+});
