+++ b/evaluation/gate/fetch-resource.mjs
@@ -0,0 +1,41 @@
+/**
+ * Fetch one skill resource's raw bytes from the skill bridge.
+ *
+ * The bridge's `files/read` returns a JSON envelope
+ * `{ code, message, data: { path, content, encoding, size_bytes, mime_type, version } }`
+ * (see MemoryCore `handleFilesRead` → `core.readFile`). `data.content` is a
+ * string in the encoding named by `data.encoding`; this decodes it back to
+ * bytes so the caller can write the file as it was stored.
+ *
+ * Two cases the bridge's own `files/download` path gets wrong, and this tool
+ * must not:
+ *
+ *   - an empty resource is a legal file. `content: ""` is a zero-byte Buffer,
+ *     not an error, and not a reason to fall back to `data` as a whole.
+ *   - `code !== 0` is an upstream failure. It is thrown with the envelope's own
+ *     message, never swallowed and never turned into empty bytes.
+ *
+ * `fetcher` is the HTTP implementation and defaults to `globalThis.fetch`
+ * (i.e. a `Response`); tests pass a stub.
+ */
+export async function fetchResource({ skillId, path, bridgeBase, fetcher }) {
+  const doFetch = fetcher ?? globalThis.fetch;
+  const url = `${String(bridgeBase).replace(/\/+$/, "")}/files/read`;
+  const res = await doFetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ skill_id: skillId, path }),
+  });
+
+  // A real Response needs `.json()`; a plain-envelope stub may be handed
+  // straight through.
+  const envelope = typeof res?.json === "function" ? await res.json() : res;
+
+  if (!envelope || envelope.code !== 0) {
+    throw new Error(envelope?.message ?? `skill resource fetch failed (code ${envelope?.code})`);
+  }
+
+  const content = envelope.data?.content ?? "";
+  const encoding = envelope.data?.encoding === "base64" ? "base64" : "utf-8";
+  return Buffer.from(content, encoding);
+}
diff --git a/evaluation/gate/fetch-resource.test.mjs b/evaluation/gate/fetch-resource.test.mjs
