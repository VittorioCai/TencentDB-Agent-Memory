--- /dev/null
+++ b/evaluation/gate/fetch-resource.test.mjs
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fetchResource } from "./fetch-resource.mjs";
+
+const BASE = "http://bridge.test/skill-bridge/v3/skill";
+const envelopeResponse = (envelope) => new Response(JSON.stringify(envelope), { status: 200 });
+
+test("returns the resource's raw bytes and posts skill_id + path to <bridgeBase>/files/read", async () => {
+  const bytes = Buffer.from([0x00, 0xff, 0x10, 0x7f]);
+  const calls = [];
+  const fetcher = async (url, init) => {
+    calls.push({ url, init });
+    return envelopeResponse({ code: 0, message: "ok", data: { path: "a.bin", content: bytes.toString("base64"), encoding: "base64" } });
+  };
+
+  const got = await fetchResource({ skillId: "skl-x", path: "a.bin", bridgeBase: BASE, fetcher });
+
+  assert.ok(Buffer.isBuffer(got));
+  assert.deepEqual(got, bytes);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, `${BASE}/files/read`);
+  assert.equal(calls[0].init.method, "POST");
+  assert.deepEqual(JSON.parse(calls[0].init.body), { skill_id: "skl-x", path: "a.bin" });
+});
+
+test("decodes utf-8 content, and strips a trailing slash from bridgeBase", async () => {
+  const fetcher = async (url) =>
+    envelopeResponse({ code: 0, data: { content: "hello\n", encoding: "utf-8" } });
+  const got = await fetchResource({ skillId: "skl-x", path: "n.md", bridgeBase: `${BASE}/`, fetcher });
+  assert.equal(got.toString("utf-8"), "hello\n");
+});
+
+test("an empty resource is a zero-byte Buffer, not an error", async () => {
+  const fetcher = async () => envelopeResponse({ code: 0, message: "ok", data: { path: "empty.txt", content: "", encoding: "utf-8", size_bytes: 0 } });
+  const got = await fetchResource({ skillId: "skl-x", path: "empty.txt", bridgeBase: BASE, fetcher });
+  assert.ok(Buffer.isBuffer(got));
+  assert.equal(got.length, 0);
+});
+
+test("a missing content field still yields zero bytes rather than the envelope", async () => {
+  const fetcher = async () => envelopeResponse({ code: 0, data: { path: "empty" } });
+  const got = await fetchResource({ skillId: "skl-x", path: "empty", bridgeBase: BASE, fetcher });
+  assert.equal(got.length, 0);
+});
+
+test("an error envelope is thrown with the envelope's own message", async () => {
+  const fetcher = async () => envelopeResponse({ code: 40401, message: "SKILL_NOT_FOUND", data: null });
+  await assert.rejects(
+    fetchResource({ skillId: "skl-x", path: "gone.md", bridgeBase: BASE, fetcher }),
+    (err) => {
+      assert.ok(err instanceof Error);
+      assert.match(err.message, /SKILL_NOT_FOUND/);
+      return true;
+    },
+  );
+});
+
+test("a plain-envelope fetcher stub (no Response) is accepted", async () => {
+  const fetcher = async () => ({ code: 0, message: "ok", data: { content: "aGk=", encoding: "base64" } });
+  const got = await fetchResource({ skillId: "skl-x", path: "hi", bridgeBase: BASE, fetcher });
+  assert.equal(got.toString("utf-8"), "hi");
+});
