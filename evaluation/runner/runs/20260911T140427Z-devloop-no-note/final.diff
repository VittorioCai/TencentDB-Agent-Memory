+test("a real Exit Code line is read even when the stderr carries no timeout prose", () => {
+  // The field in a real CodeBuddy result is `Exit Code:` (capital C), not the
+  // `Exit code:` the older fixtures used. A case-sensitive match misses it, so
+  // this timeout loses its only signal and degrades to "outcome not readable"
+  // — a failure recorded as unreadable, which rounds to neither PASS nor FAIL.
+  const real = "Command: curl -sSk -X POST http://x -d '{}'\nStdout: \nStderr: curl: (28) SSL connection timeout\nExit Code: 28\nSignal: (none)";
+  const r = outcomeOfAttempt(real);
+  assert.equal(r.ok, false, "a real envelope's exit 28 must read as a failure");
+  assert.equal(r.why, "timed out");
+  assert.notEqual(r.why, "outcome not readable");
+});
